# Локальные значения-примеры. Скопируйте файл в .env и замените пароли.
SERVER_ADDRESS=:8080

DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
POSTGRES_DB=riscv_catalog
POSTGRES_USER=riscv_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=riscv-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_BUCKET=riscv-assets
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000/riscv-assets

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Секрет подписи JWT (HS256), не короче 32 символов: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL=1h
