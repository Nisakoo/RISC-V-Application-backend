{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Веб-сервис каталога команд RISC-V: лента, черновики, публикация, лайки и пользователи. Без JWT доступно только чтение списка и ленты.",
        "title": "API команд RISC-V",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/riscv_commands": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает опубликованные команды с фильтрацией по количеству операндов. Доступен гостю; для аутентифицированного пользователя is_creator = 1 у его команд.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Список опубликованных команд RISC-V",
                "parameters": [
                    {
                        "maximum": 3,
                        "minimum": 0,
                        "type": "integer",
                        "description": "Минимальное количество операндов",
                        "name": "min_operands",
                        "in": "query"
                    },
                    {
                        "maximum": 3,
                        "minimum": 0,
                        "type": "integer",
                        "description": "Максимальное количество операндов",
                        "name": "max_operands",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.apiListCommand"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создаёт черновик из мнемоники, изображения и короткого видео. Файлы сохраняются в MinIO под латинскими именами, создатель определяется по JWT.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Создание черновика команды RISC-V",
                "parameters": [
                    {
                        "type": "string",
                        "example": "XORI",
                        "description": "Мнемоника команды RISC-V",
                        "name": "mnemonic",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение PNG, JPEG или WebP до 5 МиБ",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Короткое видео MP4 до 50 МиБ",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.apiCommand"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/riscv_commands/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает единственный черновик пользователя, определённого по JWT; идентификатор не передаётся.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Черновик команды RISC-V текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.apiCommand"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/riscv_commands/feed": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Без id возвращает первую команду ленты, с id — указанную, с id и next=true — следующую после неё. Доступна гостю; is_liked = 1, если аутентифицированный пользователь поставил лайк.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Лента опубликованных команд RISC-V",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Идентификатор команды RISC-V",
                        "name": "id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Вернуть следующую команду после id",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.apiFeedCommand"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/riscv_commands/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Меняет статус собственной команды пользователя на deleted.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Логическое удаление команды RISC-V",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Идентификатор команды",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/riscv_commands/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "like = 1 ставит лайк от текущего пользователя, like = 0 отменяет его.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Лайк опубликованной команды RISC-V",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Идентификатор команды",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Признак лайка 0/1",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.apiLikeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.apiLikeResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/riscv_commands/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Заполняет описание и поля команды и меняет статус черновика текущего пользователя на published. Системные поля передавать запрещено.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "riscv_commands"
                ],
                "summary": "Публикация черновика команды RISC-V",
                "parameters": [
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "Идентификатор черновика",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Поля публикации",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.PublishRiscVCommandDraft"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.apiCommand"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/users": {
            "post": {
                "description": "Создаёт пользователя с ролью user. Логин: латиница, цифры и _, 3–64 символа; пароль: 8–72 символа.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.apiCredentials"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.apiRegisteredUser"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/users/authentication": {
            "post": {
                "description": "Проверяет логин и пароль и возвращает JWT доступа. Токен передаётся в остальных запросах заголовком Authorization: Bearer \u003ctoken\u003e.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Аутентификация пользователя",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.apiCredentials"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.apiAuthentication"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/users/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Помещает текущий JWT в blacklist Redis до истечения его срока; повторно использовать токен нельзя.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Деавторизация пользователя",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.apiErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.PublishRiscVCommandDraft": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "length_bits": {
                    "type": "integer"
                },
                "operand_count": {
                    "type": "integer"
                }
            }
        },
        "domain.RiscVCommandStatus": {
            "type": "string",
            "enum": [
                "draft",
                "published",
                "deleted"
            ],
            "x-enum-varnames": [
                "RiscVCommandDraft",
                "RiscVCommandPublished",
                "RiscVCommandDeleted"
            ]
        },
        "domain.UserRole": {
            "type": "string",
            "enum": [
                "user",
                "moderator"
            ],
            "x-enum-varnames": [
                "UserRoleUser",
                "UserRoleModerator"
            ]
        },
        "handler.apiAuthentication": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer",
                    "example": 3600
                },
                "login": {
                    "type": "string",
                    "example": "rv32_author"
                },
                "role": {
                    "enum": [
                        "user",
                        "moderator"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.UserRole"
                        }
                    ],
                    "example": "user"
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        },
        "handler.apiCommand": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "creator_login": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_key": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "length_bits": {
                    "type": "integer"
                },
                "like_count": {
                    "type": "integer"
                },
                "mnemonic": {
                    "type": "string"
                },
                "operand_count": {
                    "type": "integer"
                },
                "published_at": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.RiscVCommandStatus"
                },
                "video_key": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "handler.apiCredentials": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string",
                    "example": "rv32_author"
                },
                "password": {
                    "type": "string",
                    "example": "correct-horse-battery"
                }
            }
        },
        "handler.apiErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Команда RISC-V не найдена."
                }
            }
        },
        "handler.apiFeedCommand": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "creator_login": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_key": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "is_liked": {
                    "type": "integer"
                },
                "length_bits": {
                    "type": "integer"
                },
                "like_count": {
                    "type": "integer"
                },
                "mnemonic": {
                    "type": "string"
                },
                "next_id": {
                    "type": "integer"
                },
                "operand_count": {
                    "type": "integer"
                },
                "published_at": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.RiscVCommandStatus"
                },
                "video_key": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "handler.apiLikeRequest": {
            "type": "object",
            "properties": {
                "like": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ],
                    "example": 1
                }
            }
        },
        "handler.apiLikeResponse": {
            "type": "object",
            "properties": {
                "like": {
                    "type": "integer",
                    "example": 1
                },
                "like_count": {
                    "type": "integer",
                    "example": 4
                }
            }
        },
        "handler.apiListCommand": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "creator_login": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_key": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "is_creator": {
                    "type": "integer"
                },
                "length_bits": {
                    "type": "integer"
                },
                "like_count": {
                    "type": "integer"
                },
                "mnemonic": {
                    "type": "string"
                },
                "operand_count": {
                    "type": "integer"
                },
                "published_at": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/domain.RiscVCommandStatus"
                },
                "video_key": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "handler.apiRegisteredUser": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 7
                },
                "login": {
                    "type": "string",
                    "example": "rv32_author"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT доступа в формате «Bearer \u003ctoken\u003e» из ответа POST /api/users/authentication.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}