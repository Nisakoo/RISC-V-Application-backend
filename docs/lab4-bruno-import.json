{
  "info": {
    "name": "ЛР4 — команды RISC-V с JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Зарегистрировать пользователя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"{{login}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Аутентификация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/authentication",
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"{{login}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Список команд с фильтром",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands?min_operands=2&max_operands=3"
      }
    },
    {
      "name": "04 Создать черновик с медиа",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "mnemonic",
              "value": "XORI",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "{{image_path}}"
            },
            {
              "key": "video",
              "type": "file",
              "src": "{{video_path}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = res.getBody();",
              "if (response && response.id) {",
              "    bru.setVar(\"command_id\", response.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Получить черновик",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands/draft"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = res.getBody();",
              "if (response && response.id) {",
              "    bru.setVar(\"command_id\", response.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Опубликовать черновик",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands/{{command_id}}/publish",
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"Выполняет побитовое исключающее ИЛИ с immediate и записывает результат в rd.\", \"operand_count\": 3, \"length_bits\": 32}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Лента команд",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/riscv_commands/feed?id={{feed_command_id}}&next=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "riscv_commands",
            "feed"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{feed_command_id}}"
            },
            {
              "key": "next",
              "value": "true"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = res.getBody();",
              "// Следующий запуск запроса с next=true откроет команду после полученной",
              "if (response && response.id) {",
              "    bru.setVar(\"feed_command_id\", response.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Поставить лайк",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands/{{command_id}}/like",
        "body": {
          "mode": "raw",
          "raw": "{\"like\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Удалить свою команду",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/riscv_commands/{{command_id}}"
      }
    },
    {
      "name": "10 Деавторизация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/users/logout"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "login",
      "value": "rv32_author"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "command_id",
      "value": ""
    },
    {
      "key": "feed_command_id",
      "value": "1"
    },
    {
      "key": "image_path",
      "value": ""
    },
    {
      "key": "video_path",
      "value": ""
    }
  ]
}
